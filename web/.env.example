# Supabase → Connect → ORM → Prisma (ou Project Settings → Database).
#
# DATABASE_URL: pooler en mode "transaction" (port 6543). Utilisé par l'app
# à l'exécution — safe sous serverless (Vercel), où chaque invocation
# ouvrirait sinon sa propre connexion directe.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: même pooler, mode "session" (port 5432). Utilisé uniquement par
# la CLI Prisma (migrate/introspect) — le mode "transaction" ne supporte pas
# le verrouillage au niveau session dont Prisma Migrate a besoin.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# resend.com → API Keys. Utilisé pour l'e-mail de réinitialisation de mot de
# passe (lib/email.ts). Sans domaine vérifié sur Resend, l'expéditeur par
# défaut (onboarding@resend.dev) ne peut envoyer qu'à l'adresse e-mail du
# compte Resend lui-même — un domaine vérifié est nécessaire pour envoyer à
# n'importe quel destinataire en production.
RESEND_API_KEY="re_xxxxxxxx"
# RESEND_FROM_EMAIL="SubFlow <noreply@votredomaine.com>"

# dashboard.stripe.com → Developers → API keys. Utilisée pour créer les
# sessions de paiement (Pro / Annuel) — lib/stripe.ts, lib/billing.ts.
# Aucun produit/prix à créer côté Stripe : les montants sont envoyés
# directement à la création de la session (price_data), donc toujours
# synchronisés avec ceux affichés sur la page tarifs.
STRIPE_SECRET_KEY="sk_test_xxxxxxxx"

# dashboard.stripe.com → Developers → Webhooks → endpoint
# https://votredomaine.com/api/stripe/webhook, événements à écouter :
# checkout.session.completed, customer.subscription.deleted.
# Utilisée pour vérifier que les requêtes viennent bien de Stripe
# (app/api/stripe/webhook/route.ts).
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"
